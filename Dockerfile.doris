# Apache Doris Frontend (FE) - Tuned for Render Cloud Containers
FROM apache/doris:fe-2.1.7

WORKDIR /app

COPY RenderHealth.java /app/RenderHealth.java
COPY start_doris_fe.sh /app/start_doris_fe.sh

RUN chmod +x /app/start_doris_fe.sh

ENV PORT=10000
ENV JAVA_OPTS="-Xmx384m -Xms192m -XX:+UseG1GC"
ENV FE_SERVICENAME=doris-fe
ENV ENABLE_FQDN_MODE=true

EXPOSE 9030 10000 8030 9010 9020

ENTRYPOINT ["/bin/bash", "/app/start_doris_fe.sh"]
