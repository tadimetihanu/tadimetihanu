        res.json({ success: true, message: `Connected to ${type} database: ${name}` });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// --- Multi-Cloud Storage Connectors ---
app.post('/api/connections/:provider', async (req, res) => {
    try {
        const { provider } = req.params;
        const { testOnly, ...creds } = req.body;
        
        const fs = require('fs');
        const path = require('path');
        const envPath = path.join(__dirname, '../.env');
        let envContent = fs.readFileSync(envPath, 'utf8');

        // Map UI names to .env keys
        const providerMap = {
            aws: { Prefix: 'AWS', Keys: ['ACCESS_KEY', 'SECRET_KEY', 'REGION', 'BUCKET'] },
            azure: { Prefix: 'AZURE', Keys: ['CONNECTION_STRING', 'CONTAINER'] },
            gcp: { Prefix: 'GCP', Keys: ['PROJECT_ID', 'BUCKET', 'KEY_FILE'] },
            minio: { Prefix: 'MINIO', Keys: ['ENDPOINT', 'ACCESS_KEY', 'SECRET_KEY', 'BUCKET'] }
        };

        const config = providerMap[provider];
        if (!config) return res.status(400).json({ success: false, error: 'Unknown provider' });

        if (testOnly) {
            // Real connection test
            const { S3Client, HeadBucketCommand } = require('@aws-sdk/client-s3');
            const { BlobServiceClient } = require('@azure/storage-blob');

            try {
                if (provider === 'minio') {
                    let epInput = creds.endpoint || process.env.MINIO_ENDPOINT || 'http://localhost:9010';
                    let ep = ensureProtocol(epInput);
                    
                    // --- SMART REDIRECT: Automatically fix Console vs API port ---
                    if (ep.includes(':9011')) {
                        console.log(`[MINIO_FIX] Changing console port 9011 to API port 9010 for endpoint: ${ep}`);
                        ep = ep.replace(':9011', ':9010');
                    } else if (ep.includes(':9001')) {
                        console.log(`[MINIO_FIX] Changing console port 9001 to API port 9000 for endpoint: ${ep}`);
                        ep = ep.replace(':9001', ':9000');
                    }

                    const accessKeyId = creds.access_key || creds.access || process.env.MINIO_ACCESS_KEY || 'minioadmin';
                    const secretAccessKey = creds.secret_key || creds.secret || process.env.MINIO_SECRET_KEY || 'minioadmin';
                    const bucket = creds.bucket || creds.bucket_name || process.env.MINIO_BUCKET || 'datalake';
                    const region = creds.region || process.env.MINIO_REGION || 'us-east-1';

                    console.log(`[MINIO_TEST] EP: ${ep}, BUCKET: ${bucket}, ACCESS: ${accessKeyId}`);
                    
                    if (!accessKeyId || !secretAccessKey) {
                        throw new Error("Missing access key or secret key for MinIO connection.");
                    }

                    const { S3Client, HeadBucketCommand } = require('@aws-sdk/client-s3');
                    const s3 = new S3Client({
                        endpoint: ep,
                        region: region,
                        credentials: { accessKeyId, secretAccessKey },
                        forcePathStyle: true,
                    });
                    
                    await s3.send(new HeadBucketCommand({ Bucket: bucket }));
                    console.log(`[MINIO_TEST] ✅ Connection to "${bucket}" SUCCESSFUL`);
                    return res.json({ success: true, message: `MinIO bucket "${bucket}" reachable at ${ep}` });
                } else if (provider === 'aws') {
                    const accessKeyId = creds.access_key || creds.access;
                    const secretAccessKey = creds.secret_key || creds.secret;
                    const bucket = creds.bucket || 'datalake';
                    const region = creds.region || 'us-east-1';

                    if (!accessKeyId || !secretAccessKey) {
                        throw new Error("Missing access key or secret key for AWS connection.");
                    }

                    const { S3Client, HeadBucketCommand } = require('@aws-sdk/client-s3');
                    const s3 = new S3Client({
                        region: region,
                        credentials: { accessKeyId, secretAccessKey },
                    });
                    await s3.send(new HeadBucketCommand({ Bucket: bucket }));
                    return res.json({ success: true, message: `AWS S3 bucket "${bucket}" reachable` });
                } else if (provider === 'azure') {
                    if (!creds.connection_string) throw new Error("Azure Connection String is missing");
                    const svc = BlobServiceClient.fromConnectionString(creds.connection_string);
                    const cc  = svc.getContainerClient(creds.container || '');
                    const exists = await cc.exists();
                    if (!exists) throw new Error(`Container "${creds.container}" not found`);
                    return res.json({ success: true, message: `Azure container found` });
                }
                
                return res.json({ success: true, message: `Simulated test connection to ${provider.toUpperCase()} successful!` });
            } catch (err) {
                let msg = err.message;
                console.error(`[Test-Connection] DETAILED ERROR for ${provider}:`, err);
                if (msg === 'UnknownError') {
                    msg = `UnknownError (Check if port is correct or if server is reachable)`;
                }
                if (creds.endpoint && (creds.endpoint.includes(':9001') || creds.endpoint.includes(':9011'))) {
                    msg += " (Note: You are trying to connect to the Console port 9011. Try port 9010 for the S3 API)";
                }
                console.error(`[Test-Connection] Error msg for ${provider}:`, msg);
                return res.json({ success: false, error: msg });
            }
        }

        // Sanitizie endpoint if it is minio before saving
        if (provider === 'minio' && creds.endpoint) {
            if (creds.endpoint.includes(':9011')) creds.endpoint = creds.endpoint.replace(':9011', ':9010');
            else if (creds.endpoint.includes(':9001')) creds.endpoint = creds.endpoint.replace(':9001', ':9000');
        }

        for (const key of config.Keys) {
            const val = creds[key.toLowerCase()];
            const envKey = `${config.Prefix}_${key}`;
            if (envContent.includes(`${envKey}=`)) {
                envContent = envContent.replace(new RegExp(`${envKey}=.*`), `${envKey}=${val}`);
            } else {
                envContent += `\n${envKey}=${val}`;
            }
            process.env[envKey] = val;
        }

        fs.writeFileSync(envPath, envContent);
        res.json({ success: true, message: `${provider.toUpperCase()} connection saved successfully.` });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});


// ── Query Builder APIs ────────────────────────────────────────
app.get('/api/query-builder/tables', async (req, res) => {
    try {
        const files = await listFiles('all');
        const tables = files.map(f => ({ name: f.name, type: f.name.endsWith('.parquet') ? 'Parquet' : 'CSV' }));
        
        // Add some mock DB tables for demonstration
        tables.push(
            { name: 'mysql.users', type: 'MySQL' },
            { name: 'postgres.transactions', type: 'Postgres' },
            { name: 'sqlserver.inventory', type: 'SQL Server' }
        );
        
        res.json({ success: true, tables });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

app.post('/api/query-builder/generate-sql', (req, res) => {
    const { table, columns, filters, limit } = req.body;
    let sql = `SELECT ${columns.length ? columns.join(', ') : '*'} FROM '${table}'`;
    
    const filterClauses = Object.entries(filters).map(([col, val]) => {
        const escaped = typeof val === 'string' ? `'${val}'` : val;
        return `"${col}" = ${escaped}`;
    });
    
    if (filterClauses.length) {
        sql += ` WHERE ${filterClauses.join(' AND ')}`;
    }
    
    if (limit) sql += ` LIMIT ${limit}`;
    
    res.json({ success: true, sql });
});


// ── Audit Log Endpoint ───────────────────────────────────────
app.get('/api/audit', (req, res) => {
    try {
        if (!fs.existsSync(AUDIT_LOG)) return res.json({ success: true, entries: [] });
        const raw = fs.readFileSync(AUDIT_LOG, 'utf-8');
        const entries = raw.trim().split('\n').filter(Boolean).slice(-100);
        res.json({ success: true, entries });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// ── Live Logs Endpoint ───────────────────────────────────────
app.get('/api/logs', (req, res) => {
    res.json({ success: true, logs: LOG_HISTORY });
});

// ── External Ingest API ───────────────────────────────────────
app.post('/api/logs/ingest', (req, res) => {
    const { level, message, source } = req.body;
    if (!message) return res.status(400).json({ success: false, error: 'Message required' });
    logToClients(level || 'INFO', message, source || 'EXTERNAL');
    res.json({ success: true });
});

app.use(express.static(path.join(__dirname, '../public')));

const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });
global.io = io; // Make it accessible to logToClients

io.on('connection', (socket) => {
    console.log('Client connected:', socket.id);
    socket.on('disconnect', () => console.log('Client disconnected:', socket.id));
});

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => { console.log(`Datainseek BI Explorer at http://localhost:${PORT}`); });
