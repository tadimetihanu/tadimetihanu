// ── Global crash guards — keep the server alive on unhandled errors ──
process.on('uncaughtException', (err) => {
    console.error('[FATAL] Uncaught Exception:', err);
});
process.on('unhandledRejection', (reason) => {
    console.error('[FATAL] Unhandled Rejection:', reason);
});
require('dotenv').config();

const express = require('express');
const http = require('http');
const path = require('path');
const cors = require('cors');
const { Server } = require('socket.io');
const { BlobServiceClient } = require('@azure/storage-blob');
const { listFiles, getFileSchema, uploadFile } = require('./drivers/storage');
const { runQuery, setEngineConfig } = require('./query/engine');

const multer = require('multer');
const upload = multer({ storage: multer.memoryStorage(), limits: { fileSize: 100 * 1024 * 1024 } }); // 100 MB
const fs = require('fs');

const app = express();
app.use(cors());
app.use(express.json());

const AUDIT_LOG = path.join(__dirname, '../audit.log');
const LOG_HISTORY = [];
const MAX_LOGS = 200;

function logToClients(level, msg, source = 'SERVER') {
    const logEntry = { timestamp: new Date().toISOString(), level, message: msg, source };
    LOG_HISTORY.push(logEntry);
    if (LOG_HISTORY.length > MAX_LOGS) LOG_HISTORY.shift();
    if (global.io) global.io.emit('server-log', logEntry);
}

// ── AUDIT LOG WATCHER ─────────────────────────────────────────
if (fs.existsSync(AUDIT_LOG)) {
    let lastSize = fs.statSync(AUDIT_LOG).size;
    fs.watchFile(AUDIT_LOG, { interval: 1000 }, (curr) => {
        if (curr.size > lastSize) {
            const stream = fs.createReadStream(AUDIT_LOG, { start: lastSize, end: curr.size });
            stream.on('data', (chunk) => {
                const lines = chunk.toString().split('\n').filter(Boolean);
                lines.forEach(line => logToClients('INFO', line, 'AUDIT'));
            });
            lastSize = curr.size;
        }
    });
}

// Redirect console to also broadcast through Socket.io
const originalLog = console.log;
const originalError = console.error;
console.log = (...args) => {
    originalLog(...args);
    logToClients('INFO', args.join(' '));
};
console.error = (...args) => {
    originalError(...args);
    logToClients('ERROR', args.join(' '));
};

function logAudit(user, role, action, detail) {
    const entry = `[${new Date().toISOString()}] user=${user} role=${role} action=${action} detail=${detail}\n`;
    fs.appendFileSync(AUDIT_LOG, entry);
}

// Convert BigInt values returned by DuckDB to regular Numbers
function sanitizeBigInt(obj) {
    if (obj === null || obj === undefined) return obj;
    if (typeof obj === 'bigint') return Number(obj);
    if (Array.isArray(obj)) return obj.map(sanitizeBigInt);
    if (typeof obj === 'object') {
        const out = {};
        for (const [k, v] of Object.entries(obj)) out[k] = sanitizeBigInt(v);
        return out;
    }
    return obj;
}

function ensureProtocol(url) {
    if (!url) return url;
    let out = url.trim();
    if (!/^https?:\/\//i.test(out)) out = 'http://' + out;
    return out.replace(/\/+$/, ''); // Strip trailing slashes
}

// ── Runtime Config (updated from Settings UI) ─────────────────
app.post('/api/config', (req, res) => {
    const { minio, minio2, azure, s3, adls } = req.body;
    const storage = require('./drivers/storage');
    if (azure?.connstr)   storage.setAzureConfig(azure);
    if (minio?.endpoint)  storage.setMinioConfig(minio);
    if (minio2?.endpoint) storage.setMinio2Config(minio2);
    if (s3?.endpoint)     storage.setS3Config(s3);
    if (adls?.connstr)    storage.setAdlsConfig(adls);

    setEngineConfig({
        minio: minio || null,
        minio2: minio2 || null,
        azure: azure || null,
        s3: s3 || null,
        adls: adls || null
    });
    res.json({ success: true });
});

