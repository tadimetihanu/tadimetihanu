});

// ── Schema Inspection ──────────────────────────────────
app.get('/api/schema', async (req, res) => {
    const { file, provider, isScan } = req.query;
    if (!file) return res.json({ success: false, error: 'file param required' });

    const os = require('os');
    const { runQuery } = require('./query/engine');
    const tempFiles = [];

    try {
        let fromExpr;  // the expression to use in FROM clause

        if (isScan === 'true') {
            fromExpr = file;
        } else {
            const ext = file.split('.').pop().toLowerCase();
            const localPath = path.join(__dirname, '../data', file);
            
            if (fs.existsSync(localPath)) {
                const safePath = localPath.replace(/\\/g, '/');
                fromExpr = (ext === 'csv') 
                    ? `read_csv_auto('${safePath}', ignore_errors=true, strict_mode=false)` 
                    : `'${safePath}'`;
            } else {
                // Try Azure Blob if configured
                const storage = require('./drivers/storage');
                const azureConn = storage._azureCfg?.connstr || process.env.AZURE_STORAGE_CONNECTION_STRING || '';
                const azureCont = storage._azureCfg?.container || process.env.AZURE_CONTAINER || 'datainseektech';
                
                if (azureConn) {
                    try {
                        const svc = BlobServiceClient.fromConnectionString(azureConn);
                        const blobClient = svc.getContainerClient(azureCont).getBlobClient(file);
                        if (await blobClient.exists()) {
                            const tmpPath = path.join(os.tmpdir(), `schema_${Date.now()}_${path.basename(file)}`);
                            await blobClient.downloadToFile(tmpPath);
                            tempFiles.push(tmpPath);
                            const safeTmp = tmpPath.replace(/\\/g, '/');
                            fromExpr = (ext === 'csv') 
                                ? `read_csv_auto('${safeTmp}', ignore_errors=true, strict_mode=false)` 
                                : `'${safeTmp}'`;
                        }
                    } catch (azErr) { console.warn('[Schema/Azure]', azErr.message); }
                }
                
                // Fallback to bare filename (resolved via S3/engine if needed)
                if (!fromExpr) {
                    fromExpr = (ext === 'csv') 
                        ? `read_csv_auto('${file}', ignore_errors=true, strict_mode=false)` 
                        : `'${file}'`;
                }
            }
        }

        // Run DESCRIBE and COUNT in parallel via DuckDB
        const [descRows, countRows] = await Promise.all([
            runQuery(`DESCRIBE SELECT * FROM ${fromExpr}`),
            runQuery(`SELECT COUNT(*) AS row_count FROM ${fromExpr}`),
        ]);

        const columns = descRows.map(r => ({
            name:     r.column_name,
            type:     r.column_type,
            nullable: r.null === 'YES',
        }));
        const rowCount = Number(countRows[0]?.row_count ?? 0);

        res.json({ success: true, file, columns, rowCount });
    } catch (err) {
        res.json({ success: false, error: err.message });
    } finally {
        for (const f of tempFiles) { try { fs.unlinkSync(f); } catch {} }
    }
});


// ── Test Connection ───────────────────────────────────────────
app.post('/api/test-connection', async (req, res) => {
    const { provider, endpoint, access, secret, region, bucket,
            connstr, container } = req.body;
    try {
        if (provider === 'minio' || provider === 'minio2') {
            const { S3Client, HeadBucketCommand } = require('@aws-sdk/client-s3');
            let epInput = endpoint || process.env.MINIO_ENDPOINT || 'http://localhost:9010';
            let ep = ensureProtocol(epInput);
            
            // Fix Console vs API port
            if (ep.includes(':9011')) ep = ep.replace(':9011', ':9010');
            else if (ep.includes(':9001')) ep = ep.replace(':9001', ':9000');
            
            const c = new S3Client({
                endpoint: ep, region: region || 'us-east-1',
                credentials: { 
                    accessKeyId: access || process.env.MINIO_ACCESS_KEY || 'minioadmin', 
                    secretAccessKey: secret || process.env.MINIO_SECRET_KEY || 'minioadmin' 
                },
                forcePathStyle: true,
            });
            await c.send(new HeadBucketCommand({ Bucket: bucket || process.env.MINIO_BUCKET || 'datalake' }));
            res.json({ success: true, message: `MinIO bucket reached successfully via API at ${ep}` });
        } else if (provider === 'azure') {
            const { BlobServiceClient } = require('@azure/storage-blob');
            if (!connstr) return res.json({ success: false, error: 'Connection string is required' });
            const svc = BlobServiceClient.fromConnectionString(connstr);
            const cc  = svc.getContainerClient(container || '');
            const exists = await cc.exists();
            res.json({
                success: true,
                message: exists
                    ? `Container "${container}" found`
                    : `Connected — container "${container}" not found (check name)`
            });
        } else if (provider === 's3') {
            const { S3Client, HeadBucketCommand } = require('@aws-sdk/client-s3');
            const ep = ensureProtocol(endpoint);
            const c = new S3Client({
                endpoint: ep, region: region || 'us-east-1',
                credentials: { accessKeyId: access, secretAccessKey: secret },
            });
            await c.send(new HeadBucketCommand({ Bucket: bucket }));
            res.json({ success: true, message: `S3 bucket "${bucket}" reachable` });
        } else if (provider === 'adls') {
            const { BlobServiceClient } = require('@azure/storage-blob');
            const svc = BlobServiceClient.fromConnectionString(connstr);
            const cc  = svc.getContainerClient(container || '');
            const exists = await cc.exists();
            res.json({ success: true, message: exists ? `ADLS Gen2 container found` : `ADLS Connected (container not found)` });
        } else {
            res.json({ success: false, error: 'Unknown provider' });
        }
    } catch (err) {
        res.json({ success: false, error: err.message });
    }
});

// ── Query Endpoint ───────────────────────────────────────────
const os = require('os');

app.post('/api/query', async (req, res) => {
    const tempFiles = [];
    try {
        const { sql, config } = req.body;
        const provider = config?.provider || 'minio';
        const user     = config?.username  || 'anonymous';
        const role     = config?.role      || 'viewer';
        console.log(`[API] Query Request from ${user} (role=${role}) provider=${provider}`);
        const trace = config?.settings ? JSON.stringify(config.settings).substring(0, 100) : 'NO SETTINGS';
        console.log(`[API] [TRACE] settings: ${trace}...`);

        let finalSql = sql;

        // Extract all file references from SQL (quoted or unquoted)
        // Now includes support for spaces and parentheses in filenames
        const filePattern = /(['"]?)(\b[\w][\w.\-\s()]*\.(csv|parquet|json|xlsx|tsv))\b(['"]?)/gi;
        const fileRefs = [...new Set([...sql.matchAll(filePattern)].map(m => m[2]))];

        const storage   = require('./drivers/storage');
        const isAzureProvider = (provider === 'azure' || provider === 'adls');
        const azureConn = storage._azureCfg?.connstr || process.env.AZURE_STORAGE_CONNECTION_STRING || '';
        const azureCont = storage._azureCfg?.container || process.env.AZURE_CONTAINER || 'datainseektech';

        // Only check Azure if we are using an Azure provider OR if it's explicitly an az:// path
        if (azureConn && (isAzureProvider || finalSql.includes('az://')) && fileRefs.length > 0) {
            const svc = BlobServiceClient.fromConnectionString(azureConn);
            const containerClient = svc.getContainerClient(azureCont);

            for (const fname of fileRefs) {
                // Skip files that exist locally in data/
                const localPath = path.join(__dirname, '../data', fname);
                if (fs.existsSync(localPath)) continue;

                // Try to download from Azure Blob
                try {
                    const blobClient = containerClient.getBlobClient(fname);
                    const exists = await blobClient.exists();
                    if (!exists) continue;  // not an Azure file, skip

                    const tmpPath = path.join(os.tmpdir(), `cloudstream_${Date.now()}_${path.basename(fname)}`);
                    await blobClient.downloadToFile(tmpPath);
                    tempFiles.push(tmpPath);

                    // Replace all occurrences of this filename in SQL with the temp path
                    const safeFile = fname.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    finalSql = finalSql.replace(
                        new RegExp(`['"]?${safeFile}['"]?`, 'g'),
                        `'${tmpPath.replace(/\\/g, '/')}'`
                    );
                    console.log(`[Azure] Downloaded ${fname} → ${tmpPath}`);
                } catch (blobErr) {
                    console.warn(`[Azure] Could not download ${fname}:`, blobErr.message);
                }
            }
        }

        // Add a safety timeout for the query
        const queryPromise = runQuery(finalSql, config?.settings);
        const timeoutPromise = new Promise((_, reject) => 
            setTimeout(() => reject(new Error('Query Timeout: The operation took longer than 30 seconds.')), 30000)
        );

        const results = await Promise.race([queryPromise, timeoutPromise]);
        res.json({ success: true, data: sanitizeBigInt(results) });
    } catch (error) {
        console.error('[API] Query Error:', error.message);
        res.status(500).json({ success: false, error: error.message });
    } finally {
        for (const f of tempFiles) {
            try { if (fs.existsSync(f)) fs.unlinkSync(f); } catch {}
        }
    }
});

// ── File Upload Endpoint ──────────────────────────────────────
app.post('/api/upload', upload.array('files'), async (req, res) => {
    try {
        if (!req.files || req.files.length === 0)
            return res.status(400).json({ success: false, error: 'No files received' });
        const results = [];
        for (const file of req.files) {
            const result = await uploadFile(file.originalname, file.buffer, file.mimetype);
            logAudit('upload', 'admin', 'UPLOAD', file.originalname);
            results.push(result);
        }
        io.emit('files-updated');   // notify browsers to refresh file list
        res.json({ success: true, uploaded: results });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// ── AI Text to Query Endpoint ─────────────────────────────────
app.post('/api/ai/query', async (req, res) => {
    try {
        const { prompt, fileContext } = req.body;
        const apiKey = process.env.OPENAI_API_KEY;
        if (!apiKey) return res.status(400).json({ success: false, error: 'OpenAI API Key missing in .env' });
        
        const systemPrompt = "You are a DuckDB expert. Convert the user's plain text request into a valid DuckDB SQL query. Only output the raw SQL, without markdown blocks, commentary, or explanation. It must be valid SQL. The user is query against files, so use FROM 'filename.csv' etc. Context files available: " + fileContext;
        
        const response = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${apiKey}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                model: 'gpt-4o-mini',
                messages: [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: prompt }
                ],
                temperature: 0.2
            })
        });

        const json = await response.json();
        if (json.error) throw new Error(json.error.message);
        const sql = json.choices[0].message.content.replace(/```sql|```/g, '').trim();
        res.json({ success: true, sql });
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});

// ── AI Report Generation Endpoint ──────────────────────────────
app.post('/api/ai/generate-report', async (req, res) => {
    try {
        const { prompt, fileContext } = req.body;
        const apiKey = process.env.OPENAI_API_KEY;
        if (!apiKey) return res.status(400).json({ success: false, error: 'OpenAI API Key missing in .env' });

        // ── Schema Extraction Logic ─────────────────────────────
        const files = (fileContext || "").split(",").map(f => f.trim()).filter(Boolean);
        let schemaPrompt = "";
        
        try {
            const schemas = await Promise.all(files.map(async (file) => {
                try {
                    const desc = await runQuery(`DESCRIBE SELECT * FROM '${file}' LIMIT 1`);
                    const cols = desc.map(c => `${c.column_name} (${c.column_type})`).join(", ");
                    return `File '${file}': ${cols}`;
                } catch (e) {
                    return `File '${file}': Schema unknown`;
                }
            }));
            schemaPrompt = schemas.join("\n");
        } catch (schemaErr) {
            console.warn('[AI Report] Schema fetch failed:', schemaErr.message);
        }

        const systemPrompt = `You are a Report Builder for Lumina BI. 
Based on the user request and available data context, design a 4-section report.
IMPORTANT: You MUST use the exact column names provided in the schema context below.

Schema Context:
${schemaPrompt}

Output ONLY a JSON object with this structure:
{
  "title": "Report Title",
  "sections": [
    {
      "type": "kpi",
      "content": { "title": "Main KPI", "sql": "SELECT SUM(col) as value FROM 'file.csv'", "label": "Text Label" }
    },
    {
      "type": "chart",
      "content": { "title": "Distribution", "sql": "SELECT col1, SUM(col2) as total FROM 'file.csv' GROUP BY col1", "chartType": "bar" }
    },
    {
      "type": "text",
      "content": { "title": "Section Title", "text": "Insight about the data..." }
    }
  ]
}`;

        const response = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${apiKey}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                model: 'gpt-4o-mini',
                messages: [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: prompt }
                ],
                temperature: 0.7,
                response_format: { type: "json_object" }
            })
        });

        const json = await response.json();
        if (json.error) throw new Error(json.error.message);
        const textData = json.choices[0].message.content;
        console.log('[AI Report] Raw response:', textData);
        
        try {
            const reportData = JSON.parse(textData);
            res.json({ success: true, report: reportData });
        } catch (parseErr) {
            console.error('[AI Report] JSON Parse Error:', parseErr.message, 'Raw text:', textData);
            res.status(500).json({ success: false, error: 'AI returned invalid JSON: ' + parseErr.message });
        }
    } catch (err) {
        console.error('[AI Report] Fatal Error:', err.message);
        res.status(500).json({ success: false, error: err.message });
    }
});

// ── Anomaly Detection Engine ──────────────────────────────────
app.get('/api/analytics/anomalies', async (req, res) => {
    try {
        const { file, column } = req.query;
        if (!file || !column) return res.status(400).json({ success: false, error: 'File and column required' });

        const { runQuery } = require('./query/engine');
        
        // 1. Calculate stats manually via DuckDB for performance
        const stats = await runQuery(`
            SELECT 
                avg("${column}") as mean, 
                stddev("${column}") as std 
            FROM '${file}'
        `);
        
        const { mean, std } = stats[0];
        if (!std) return res.json({ success: true, anomalies: [], message: 'Not enough variance' });

        // 2. Identify outliers using Z-score > 2
        const threshold = 2;
        const anomalies = await runQuery(`
            SELECT * FROM '${file}' 
            WHERE ABS(("${column}" - ${mean}) / ${std}) > ${threshold}
            ORDER BY "${column}" DESC
        `);

        res.json(sanitizeBigInt({ success: true, mean, std, anomalies }));
    } catch (err) {
        res.status(500).json({ success: false, error: err.message });
    }
});


